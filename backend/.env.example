# Application Settings
ENV=development  # development or prod
SECRET=your-jwt-secret-key
HASH=sha256
LOGIN_EXPIRE=2  # JWT token expiration in hours

# Database Settings
TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# CORS Settings
FRONTEND_ORIGIN=http://localhost:3000  # In production, set to your frontend URL (e.g., https://your-app.vercel.app)